<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
   <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
    <div class="w-full flex justify-end">
        <a class="bg-red-500 rounded-md px-3 py-2 text-sm inline-block mb-5" href="/logout">Logout</a>
    </div>
<div class="flex items-start gap-3">
    <div class="w-16 h-16 rounded-full overflow-hidden">
    <img
        class="w-full h-full object-cover"
        src="/images/uploads/<%= user.profilepic || 'default.jpg' %>"
        alt="<%= user.name %>"
    >
</div> 
    <h3 class="text-3xl"> Hello, <%= user.name %>👋</h3>

</div>
    <h5 class="mb-5">You can create a new post.</h5>

    <form method="post" action="/post">
      <textarea placeholder="What's Your mind ?" class="p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md block" name="content" required></textarea>
      <input class="px-3 py-2 w-40 bg-blue-500 block rounded-md mt-2 text-sm cursor-pointer" type="submit" value="Create New Post">
    </form>

    <div class="posts mt-20">
      <h3 class="text-zinc-400">Your Posts.</h3>
      <div class="postcontainer mt-5">

        <% user.posts.forEach(function(post){ %>
        <div class="post w-1/3 p-2 rounded-md border-[1px] border-zinc-800 mb-3">
            <h4 class="text-blue-500 mb-5">@<%= user.username %></h4>
            <p class="text-sm tracking-tight"><%= post.content %></p>

            <small class="mt-2 inline-block text-zinc-400">
                <%= (post.likes ? post.likes.length : 0) %> likes
            </small>
                    
            <div class="btns flex gap-4 mt-5">
                <% if (post.likes && post.likes.indexOf(user._id) !== -1) { %>
                    <a class="text-blue-500" href="/like/<%= post._id %>">Unlike</a>
                <% } else { %>
                    <a class="text-blue-500" href="/like/<%= post._id %>">Like</a>
                <% } %>
                <a class="text-zinc-600" href="/edit/<%= post._id %>">edit</a>
                <a class="text-red-500" href="/delete/<%= post._id %>">delete</a>
            </div>
        </div>
        <% }) %>

      </div>
    </div>
   </div>
</body>
</html>