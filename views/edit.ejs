<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
   <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
    <div class="w-full flex justify-end">
        <a class="bg-red-500 rounded-md px-3 py-2 text-sm inline-block mb-5" href="/logout">Logout</a>
    </div>

    <h5 class="mb-5">Edit your post.</h5>

    <form method="post" action="/update/<%= post._id %>">
      <textarea placeholder="What's Your mind ?" class="p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md block" name="content" required><%= post.content %></textarea>
      <input class="px-3 py-2 w-40 bg-yellow-500 block rounded-md mt-2 text-sm  text-black cursor-pointer" type="submit" value="Update Post">
    </form>
   </div>
</body>
</html>